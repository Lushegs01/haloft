NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://haloft.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=optional-google-maps-key

# Server-only secrets — never expose with a NEXT_PUBLIC prefix
# Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Paystack Dashboard > Settings > API Keys & Webhooks (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
# Resend API key for transactional emails (booking/payment lifecycle)
RESEND_API_KEY=re_your-resend-key
# Verified sender; must be on your Resend-verified domain
EMAIL_FROM=Haloft <no-reply@haloft.homes>

# ── Rate limiting ───────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without these the limiter falls back to an
# in-memory counter, which on a serverless platform means per-instance
# limits that reset on every cold start — three warm instances each grant
# the full allowance, so "10 per minute" is not 10 per minute.
# Create a database at https://console.upstash.com (Redis, REST enabled).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Scheduled jobs ──────────────────────────────────────────
# Authorises /api/cron/expire-bookings and /api/cron/notifications.
# Both routes refuse EVERY request when this is unset — an endpoint that
# accepts the world because a variable is missing is the wrong default.
# On Vercel, setting this makes the platform send it automatically as
# `Authorization: Bearer`; vercel.json declares the schedules.
# Generate one with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string
