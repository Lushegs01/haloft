NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://haloft.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=optional-google-maps-key

# Server-only secrets — never expose with a NEXT_PUBLIC prefix
# Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Paystack Dashboard > Settings > API Keys & Webhooks (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
